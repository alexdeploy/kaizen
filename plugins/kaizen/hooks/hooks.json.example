{
  "_comment": "kaizen :: reference wiring for the hooks kaizen actually implements. The real hooks.json next to this file is what ships and is active. This example exists to show the shape; the 26 no-op stubs it used to document were deleted in phase 5 \u2014 shipping no-ops to users as if they were features is how a plugin loses trust. Intended behaviour for the unimplemented events is tracked in TODO.md, not in shipped code.",
  "_docs": "https://code.claude.com/docs/en/hooks",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/session-start.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/stop.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/pre-tool-use.sh"
          }
        ]
      }
    ]
  }
}
